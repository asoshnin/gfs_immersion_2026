{
  "hosting": {
    "public": "site",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "gfs-platform",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {"key": "Cache-Control", "value": "public, max-age=300, must-revalidate"}
        ]
      },
      {
        "source": "**/*.@(svg|png|jpg|ico|woff2)",
        "headers": [
          {"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}
        ]
      },
      {
        "source": "**/*.@(html|json)",
        "headers": [
          {"key": "Cache-Control", "value": "public, max-age=300, must-revalidate"}
        ]
      }
    ]
  }
}